#include <iostream>
#include <vector>
#include <climits>
using namespace std;

int main() {
    int n, amount;

    cout << "Enter the number of coin denominations: ";
    cin >> n;

    vector<int> coins(n);

    cout << "Enter the coin denominations: ";
    for (int i = 0; i < n; i++) {
        cin >> coins[i];
    }

    cout << "Enter the amount: ";
    cin >> amount;

    // DP array
    vector<int> dp(amount + 1, INT_MAX);

    // Zero coins are required to make amount 0
    dp[0] = 0;

    // Calculate minimum coins for each amount
    for (int i = 1; i <= amount; i++) {

        for (int coin : coins) {

            if (coin <= i && dp[i - coin] != INT_MAX) {
                dp[i] = min(dp[i], dp[i - coin] + 1);
            }
        }
    }

    // Display result
    if (dp[amount] == INT_MAX) {
        cout << "The given amount cannot be formed using the given coins."
             << endl;
    } else {
        cout << "Minimum number of coins required = "
             << dp[amount] << endl;
    }

    return 0;
}
